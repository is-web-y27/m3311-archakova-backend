{{#> layout title="Музыкальные Новости"}}

<section id="news" class="section section--news">
  <h2 class="section__title">Новости</h2>

  <div class="news-grid">
    {{#each articles}}
      <article class="article">

        <h3 class="article__title">
          <a href="/articles/{{id}}">
            {{title}}
          </a>
        </h3>

        {{#if coverUrl}}
          <img
            class="article__cover"
            src="{{coverUrl}}"
            alt="Обложка статьи {{title}}"
          >
        {{/if}}

        {{#if summary}}
          <p>
            <strong>{{summary}}</strong>
          </p>
        {{/if}}

        <p>
          <strong>Автор:</strong>
          {{author.name}}
        </p>

        {{#if artist}}
          <p>
            <strong>Артист:</strong>
            {{artist.stageName}}
          </p>
        {{/if}}

        {{#if publishedAt}}
          <p>
            <strong>Дата публикации:</strong>
            {{formatDate publishedAt}}
          </p>
        {{/if}}

        <div class="article__content">
          <p>{{content}}</p>
        </div>

      </article>
    {{else}}
      <p>Новостей пока нет.</p>
    {{/each}}
  </div>
</section>

<div class="banner" role="complementary">
  Реклама: новые релизы каждую пятницу!
</div>

{{/layout}}