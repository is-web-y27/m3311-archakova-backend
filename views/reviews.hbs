{{#> layout title="Обзоры"}}

<section id="reviews" class="section section--reviews">
  <h2 class="section__title">
    Обзоры
  </h2>

  <div class="reviews-list">
    {{#each articles}}
      <article class="article">

        <h3 class="article__title">
          <a href="/articles/{{id}}">
            {{title}}
          </a>
        </h3>

        {{#if summary}}
          <p>
            <strong>{{summary}}</strong>
          </p>
        {{/if}}

        <p>
          <strong>Автор:</strong>
          {{author.name}}
        </p>

        {{#if artist}}
          <p>
            <strong>Артист:</strong>
            {{artist.stageName}}
          </p>
        {{/if}}

        {{#if publishedAt}}
          <p>
            <strong>Дата публикации:</strong>
            {{formatDate publishedAt}}
          </p>
        {{/if}}

        <div class="article__content">
          <p>{{content}}</p>
        </div>

      </article>
    {{else}}
      <p>Обзоров пока нет.</p>
    {{/each}}
  </div>
</section>

{{/layout}}