{{#> layout title=user.name}}

<section class="section">
  <h1>{{user.name}}</h1>

  <p>
    <strong>Email:</strong>
    {{user.email}}
  </p>

  <p>
    <strong>Роль:</strong>
    {{user.role}}
  </p>

  <a href="/users/{{user.id}}/edit">
    Редактировать
  </a>

  <form
    action="/users/{{user.id}}?_method=DELETE"
    method="POST"
  >
    <button type="submit">
      Удалить
    </button>
  </form>

  <a href="/users">
    Назад к списку
  </a>
</section>

{{/layout}}