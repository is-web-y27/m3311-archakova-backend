{{#> layout title="Добавить пользователя"}}

<section class="section">
  <h1>Добавить пользователя</h1>

  <form
    action="/users"
    method="POST"
  >
    <div>
      <label for="name">
        Имя
      </label>

      <input
        id="name"
        name="name"
        type="text"
        required
      >
    </div>

    <div>
      <label for="email">
        Email
      </label>

      <input
        id="email"
        name="email"
        type="email"
        required
      >
    </div>

    <div>
      <label for="role">
        Роль
      </label>

      <input
        id="role"
        name="role"
        type="text"
        value="user"
      >
    </div>

    <button type="submit">
      Создать
    </button>
  </form>

  <a href="/users">
    Назад к списку
  </a>
</section>

{{/layout}}