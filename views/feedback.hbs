{{#> layout title="Обратная связь"}}

<section class="section">
  <h1 class="section__title">Обратная связь</h1>

  <p>
    Здесь можно посмотреть отзывы пользователей о Mononews.
  </p>

  <a href="/feedback/add">
    Добавить отзыв
  </a>

  <div class="feedback-list">
    {{#each feedbacks}}
      <article class="feedback-item">
        <h3>
          <a href="/feedback/{{id}}">
            {{user.name}}
          </a>
        </h3>

        <p>
          {{message}}
        </p>

        <p>
          <strong>Оценка:</strong>
          {{rating}} / 5
        </p>
      </article>
    {{else}}
      <p>Отзывов пока нет.</p>
    {{/each}}
  </div>
</section>

{{/layout}}