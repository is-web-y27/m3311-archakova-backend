{{#> layout title=article.title}}

<section class="section">
  <h1 class="section__title">
    {{article.title}}
  </h1>

  {{#if article.coverUrl}}
    <img
      class="article__cover"
      src="{{article.coverUrl}}"
      alt="Обложка статьи {{article.title}}"
    >
  {{/if}}
  
  <form class="cover-form" data-article-id="{{article.id}}">
    <label>
      Обложка статьи:
      <input
        type="file"
        name="file"
        accept="image/png,image/jpeg,image/webp"
        required
      >
    </label>

    <button type="submit">
      Загрузить обложку
    </button>
  </form>
  
  <p>
    <strong>Тип:</strong>
    {{typeLabel}}
  </p>

  <p>
    <strong>Автор:</strong>
    {{article.author.name}}
  </p>

  {{#if article.artist}}
    <p>
      <strong>Артист:</strong>
      {{article.artist.stageName}}
    </p>
  {{else}}
    <p>
      <strong>Артист:</strong>
      не указан
    </p>
  {{/if}}

  {{#if article.summary}}
    <p>
      <strong>Краткое описание:</strong>
      {{article.summary}}
    </p>
  {{/if}}

  <div>
    <strong>Текст статьи:</strong>
    <p>{{article.content}}</p>
  </div>

  {{#if article.publishedAt}}
    <p>
      <strong>Дата публикации:</strong>
      {{formatDate article.publishedAt}}
    </p>
  {{/if}}

  {{#if canManage}}
  <div class="article-actions">
    <a href="/articles/{{article.id}}/edit">
      Редактировать
    </a>

    <form
      action="/articles/{{article.id}}?_method=DELETE"
      method="POST"
    >
      <button type="submit">
        Удалить
      </button>
    </form>
  </div>
  {{/if}}

  <div class="article-navigation">
    <a href="{{backUrl}}">
      Назад к разделу
    </a>
  </div>
</section>

{{/layout}}
