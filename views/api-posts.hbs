{{#> layout title="Живая лента"}}

<section id="live" class="section">
  <h2 class="section__title">
    Живая лента постов
  </h2>

  <button
    type="button"
    id="posts-reload"
    class="feedback-form__submit posts__reload"
  >
    Обновить ленту
  </button>

  <div class="posts">

    <div
      id="posts-loader"
      class="posts__loader"
      aria-hidden="true"
    >
      <div class="spinner"></div>
      <span>Загружаем посты...</span>
    </div>

    <div
      id="posts-error"
      class="posts__error"
      hidden
    ></div>

    <div
      id="posts-list"
      class="posts__list"
    ></div>
  </div>

  <template id="post-template">
    <article class="post">
      <h3 class="post__title"></h3>
      <p class="post__body"></p>
      <p class="post__meta"></p>
    </article>
  </template>
</section>

{{/layout}}