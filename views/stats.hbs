{{#> layout title="Статистика"}}

<section id="stats" class="section stats">
  <h2 class="section__title">
    Доход музыкальных лейблов
  </h2>

  <table class="table">
    <thead>
      <tr>
        <th>Лейбл</th>
        <th>Год</th>
        <th>Доход</th>
        <th>Доля рынка</th>
      </tr>
    </thead>

    <tbody>
      {{#each labelStats}}
        <tr>
          <td>{{label.name}}</td>

          <td>{{year}}</td>

          <td>{{revenue}}</td>

          <td>
            {{#if marketShare}}
              {{marketShare}}%
            {{else}}
              —
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4">
            Статистики пока нет.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>

{{/layout}}