<div class="session">

{{#if user}}
  <p>
    Вы вошли как <a href="/profile">{{user.name}}</a>
    {{#if user.isAdmin}}<span class="session__role">Администратор</span>{{/if}}
  </p>
  <form action="/logout" method="POST">
    <button type="submit">Выйти</button>
  </form>
{{else}}
  <p>
    <a href="/login">Войти</a>
    <a href="/register">Регистрация</a>
  </p>
{{/if}}

</div>
